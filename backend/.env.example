# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# SECURITY & AUTHENTICATION
JWT_SECRET=super-secret-shadow-ai-defense-jwt-token-key-2026!
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# DATABASE CONFIGURATION
# Set DATABASE_URL to connect to PostgreSQL (e.g. postgresql://postgres:postgres@localhost:5432/shadow_ai_db)
# If left blank or unset, system automatically uses zero-config embedded SQLite at database/shadow_ai.db
DATABASE_URL=
DB_TYPE=sqlite
SQLITE_DB_PATH=../database/shadow_ai.db

# DETECTION ENGINE MICROSERVICE
DETECTION_SERVICE_URL=http://localhost:8000
